{
  "name": "@repo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MegDB — public Next.js app (movies & TV discovery)",
  "scripts": {
    "predev": "pnpm run verify:seo",
    "dev": "next dev --port 3000",
    "prestart": "pnpm run verify:seo",
    "build": "pnpm run verify:seo && next build",
    "analyze": "ANALYZE=true next build",
    "start": "pnpm run verify:seo && next start",
    "lint": "pnpm run verify:semantic:buttons && eslint .",
    "type-check": "tsc --noEmit",
    "test": "pnpm run verify:seo && vitest run",
    "verify:jsonld": "node ./scripts/verify-jsonld-coverage.mjs",
    "verify:seo:contracts": "node ./scripts/verify-seo-contracts.mjs",
    "verify:seo:infra": "node ./scripts/verify-seo-infra.mjs",
    "verify:seo:noindex": "node ./scripts/verify-seo-noindex-robots.mjs",
    "verify:seo:sitemap": "node ./scripts/verify-seo-sitemap-contract.mjs",
    "verify:seo:schema": "node ./scripts/verify-seo-schema-contract.mjs",
    "verify:seo:freshness-eeat": "node ./scripts/verify-seo-freshness-eeat.mjs",
    "verify:seo:canonical": "node ./scripts/verify-seo-canonical-contract.mjs",
    "verify:seo:consistency": "node ./scripts/verify-seo-consistency.mjs",
    "verify:seo:crawl-budget": "node ./scripts/verify-seo-crawl-budget.mjs",
    "verify:seo:links": "node ./scripts/verify-seo-internal-links.mjs",
    "verify:seo:programmatic": "node ./scripts/verify-seo-programmatic-policy.mjs",
    "verify:seo:scaffold": "node ./scripts/verify-seo-scaffold.mjs",
    "verify:seo:scaffold:staged": "node ./scripts/verify-seo-scaffold-staged.mjs",
    "verify:seo:scaffold:sync-staged": "node ./scripts/sync-seo-scaffold-staged.mjs",
    "verify:seo:report": "node ./scripts/verify-seo-report.mjs",
    "verify:seo:full": "node ./scripts/verify-seo-report.mjs",
    "verify:seo:quick": "node ./scripts/verify-seo-report.mjs --quick",
    "verify:seo": "pnpm run verify:seo:quick",
    "verify:tokens": "node ../../scripts/verify-tailwind-tokens.mjs",
    "verify:semantic:buttons": "node ./scripts/verify-semantic-button-states.mjs",
    "verify:seo:smoke": "node ./scripts/seo-smoke.mjs",
    "verify:seo:monitor": "node ./scripts/seo-monitor-regression.mjs",
    "verify:seo:nightly": "node ./scripts/seo-nightly.mjs",
    "verify:seo:weekly": "node ./scripts/seo-weekly-audit.mjs",
    "verify:seo:weekly:dry": "node ./scripts/seo-weekly-audit.mjs --dry-run",
    "seo:ops": "pnpm run verify:seo:smoke && pnpm run verify:seo:monitor && pnpm run seo:webmaster:status",
    "seo:ops:weekly": "pnpm run verify:seo:weekly",
    "seo:create-page": "node ./scripts/create-seo-page.mjs",
    "seo:webmaster:status": "node ./scripts/seo-webmaster-loop.mjs status",
    "seo:webmaster:record": "node ./scripts/seo-webmaster-loop.mjs record",
    "seo:indexnow": "node ./scripts/indexnow-submit-sitemap.mjs",
    "seo:indexnow:dry": "node ./scripts/indexnow-submit-sitemap.mjs --dry-run",
    "seo:indexnow:trigger": "node ./scripts/trigger-indexnow-endpoint.mjs",
    "seo:indexnow:trigger:dry": "node ./scripts/trigger-indexnow-endpoint.mjs --dry-run"
  },
  "dependencies": {
    "@auth/core": "^0.34.3",
    "@repo/types": "workspace:*",
    "@repo/ui": "workspace:*",
    "country-flag-icons": "^1.6.16",
    "framer-motion": "^12.0.0",
    "lucide-react": "^1.11.0",
    "next": "^16.2.4",
    "next-auth": "^4.24.14",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.2.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.0",
    "eslint-config-next": "^16.2.4",
    "postcss": "^8.5.12",
    "postcss-load-config": "^6.0.1",
    "tailwindcss": "3",
    "typescript": "^5.8.0"
  }
}
