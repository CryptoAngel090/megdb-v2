# Monorepo root — optional shared dev secrets.
# `apps/web` merges these into process.env (via next.config.ts) when a key is not
# already set in apps/web/.env.local — handy for TMDB shared with apps/api.
#
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# API email moderation for movie comments
RESEND_API_KEY=
COMMENT_MODERATION_EMAIL=
API_URL=http://localhost:5000
