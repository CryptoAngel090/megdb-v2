{
  "name": "megdb",
  "private": true,
  "description": "MegDB monorepo — movies & TV discovery platform",
  "scripts": {
    "predev": "pnpm run generate:design-tokens && pnpm run verify:tokens && pnpm run verify:seo",
    "dev": "turbo dev",
    "verify:tokens": "node scripts/verify-tailwind-tokens.mjs",
    "generate:design-tokens": "node scripts/generate-token-classmaps.mjs",
    "tokens:build": "style-dictionary build --config style-dictionary.config.json",
    "tokens:figma:sync": "node scripts/sync-figma-tokens.mjs",
    "tokens:sync": "pnpm run tokens:figma:sync && pnpm run tokens:build",
    "verify:design-tokens-sync": "pnpm run generate:design-tokens && git diff --quiet HEAD -- theme/tokens/classes.generated.json",
    "build": "pnpm run verify:tokens && pnpm run verify:design-tokens-sync && pnpm run verify:seo && turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "verify:jsonld": "pnpm --filter @repo/web run verify:jsonld",
    "verify:seo:contracts": "pnpm --filter @repo/web run verify:seo:contracts",
    "verify:seo:infra": "pnpm --filter @repo/web run verify:seo:infra",
    "verify:seo:noindex": "pnpm --filter @repo/web run verify:seo:noindex",
    "verify:seo:sitemap": "pnpm --filter @repo/web run verify:seo:sitemap",
    "verify:seo:schema": "pnpm --filter @repo/web run verify:seo:schema",
    "verify:seo:freshness-eeat": "pnpm --filter @repo/web run verify:seo:freshness-eeat",
    "verify:seo:canonical": "pnpm --filter @repo/web run verify:seo:canonical",
    "verify:seo:consistency": "pnpm --filter @repo/web run verify:seo:consistency",
    "verify:seo:crawl-budget": "pnpm --filter @repo/web run verify:seo:crawl-budget",
    "verify:seo:links": "pnpm --filter @repo/web run verify:seo:links",
    "verify:seo:programmatic": "pnpm --filter @repo/web run verify:seo:programmatic",
    "verify:seo:report": "pnpm --filter @repo/web run verify:seo:report",
    "verify:seo:full": "pnpm --filter @repo/web run verify:seo:full",
    "verify:seo:quick": "pnpm --filter @repo/web run verify:seo:quick",
    "verify:seo:scaffold": "pnpm --filter @repo/web run verify:seo:scaffold",
    "verify:seo:scaffold:staged": "pnpm --filter @repo/web run verify:seo:scaffold:staged",
    "verify:seo:scaffold:sync-staged": "pnpm --filter @repo/web run verify:seo:scaffold:sync-staged",
    "verify:seo": "pnpm --filter @repo/web run verify:seo",
    "verify:seo:smoke": "pnpm --filter @repo/web run verify:seo:smoke",
    "verify:seo:monitor": "pnpm --filter @repo/web run verify:seo:monitor",
    "verify:seo:nightly": "pnpm --filter @repo/web run verify:seo:nightly",
    "seo:ops": "pnpm --filter @repo/web run seo:ops",
    "seo:webmaster:status": "pnpm --filter @repo/web run seo:webmaster:status",
    "seo:webmaster:record": "pnpm --filter @repo/web run seo:webmaster:record",
    "seo:indexnow": "pnpm --filter @repo/web run seo:indexnow",
    "seo:indexnow:dry": "pnpm --filter @repo/web run seo:indexnow:dry",
    "seo:indexnow:trigger": "pnpm --filter @repo/web run seo:indexnow:trigger",
    "seo:indexnow:trigger:dry": "pnpm --filter @repo/web run seo:indexnow:trigger:dry",
    "test": "pnpm run verify:tokens && pnpm run verify:design-tokens-sync && pnpm run verify:seo && turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,css,md}\"",
    "biome:check": "biome check .",
    "biome:write": "biome check --write .",
    "knip": "knip",
    "knip:ci": "knip --ci",
    "lh:lcp": "node scripts/lighthouse-lcp.mjs",
    "prepare": "husky",
    "generate-manifest": "node scripts/generate-manifest.js > CODE_INDEX.md"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@eslint/js": "^9.39.1",
    "@next/eslint-plugin-next": "^15.5.15",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@web-loom/design-core": "^0.5.6",
    "eslint": "^9.0.0",
    "globals": "^17.5.0",
    "husky": "^9.1.0",
    "knip": "^6.7.0",
    "lint-staged": "^15.3.0",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "style-dictionary": "^5.4.0",
    "tsx": "^4.21.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0"
}
